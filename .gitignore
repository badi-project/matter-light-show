# Dependencies
node_modules/

# Personal data — NEVER commit:
#  - data/matter     : Matter controller identity (fabric keys, paired devices)
#  - data/*.json     : lamp names, rooms & speakers, settings, tempos, other-system tokens (Home Assistant, MQTT), phone-access key
#  - data/morceaux/  : cached cover art / 30 s previews of the songs you play
data/

# Shows you create yourself stay local too (the 4 bundled shows are tracked explicitly)
shows/*.json
!shows/chenillard-rouge.json
!shows/halloween.json
!shows/noel.json
!shows/soiree-ambiance.json

