#!/bin/bash
# « Show lumière » : démarre le logiciel en arrière-plan (service macOS) si besoin, puis ouvre la page.
# Le logiciel continue de tourner sans fenêtre et redémarre avec le Mac.
# Aussi ouverte par le bouton « Démarrer le show » de la page (lien showlumiere://).
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
URL="http://localhost:8321"
LABEL="fr.showlumiere.serveur"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

# dossier du logiciel : à côté de l'app, ou l'app est dedans, ou ~/Applications/show-lumiere-matter
APP="$(cd "$(dirname "$0")/../.." && pwd)"
PARENT="$(dirname "$APP")"
if [ -f "$PARENT/show-lumiere-matter/server.mjs" ]; then DIR="$PARENT/show-lumiere-matter"
elif [ -f "$PARENT/server.mjs" ]; then DIR="$PARENT"
else DIR="$HOME/Applications/show-lumiere-matter"; fi

alert() { /usr/bin/osascript -e "display alert \"Show lumière\" message \"$1\"" >/dev/null 2>&1; }
ping() { /usr/bin/curl -fsS -m 2 "$URL/api/ping" 2>/dev/null; }
wait_up() { for i in $(seq 1 60); do ping >/dev/null && return 0; sleep 0.5; done; return 1; }
# n'ouvre pas un 2e onglet si une page déjà ouverte vient de se reconnecter toute seule
open_page() {
  for i in 1 2 3 4 5 6 7 8; do
    case "$(ping)" in *'"pages":0'*|'') sleep 0.5 ;; *'"pages":'*) echo "page déjà ouverte"; return ;; *) break ;; esac
  done
  open "$URL"
}

if [ ! -f "$DIR/server.mjs" ]; then alert "Dossier du logiciel introuvable ($DIR)."; exit 1; fi
mkdir -p "$DIR/data"
LOG="$DIR/data/app.log"
[ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 200000 ] && : >"$LOG"
exec >>"$LOG" 2>&1
echo "--- $(date '+%d/%m %H:%M:%S') ouverture de Show lumière"

P=$(ping)
case "$P" in
  *'"service":"service"'*)
    echo "déjà en marche en arrière-plan"; open "$URL"; exit 0 ;;
  *'"service":'*)
    echo "lancé dans Terminal : passage en arrière-plan"
    /usr/bin/curl -fsS -m 3 -X POST "$URL/api/service/install" >/dev/null 2>&1
    sleep 4
    wait_up; open_page; exit 0 ;;
esac

NODE=$(command -v node)
if [ -z "$NODE" ]; then
  alert "Node.js n'est pas installé. Installe la version LTS depuis nodejs.org, puis rouvre Show lumière."
  open "https://nodejs.org/fr/download"; exit 1
fi
if [ ! -d "$DIR/node_modules/@project-chip" ]; then
  echo "installation des modules…"
  (cd "$DIR" && npm install --no-fund --no-audit >"$DIR/data/installation.log" 2>&1) || { alert "Installation impossible (connexion Internet ?)."; exit 1; }
fi

if [ -f "$PLIST" ] && launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
  echo "relance du service"
  launchctl kickstart "gui/$(id -u)/$LABEL"
else
  echo "installation du service"
  (cd "$DIR" && "$NODE" lib/service.mjs install)
fi

if wait_up; then
  echo "en marche"
  open_page
else
  echo "ne démarre pas"
  alert "Le logiciel ne démarre pas. Les détails sont dans le fichier serveur.log (dossier data)."
  open -R "$DIR/data/serveur.log"
fi
